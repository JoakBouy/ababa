# ─── Frontend ────────────────────────────────────────────────────────────────

# Mapbox token (public, safe to expose to browser for map tile rendering)
# Get a free token at https://account.mapbox.com/
# Leave blank to fall back to OpenStreetMap (no account needed)
VITE_MAPBOX_TOKEN=""

# ─── Python Backend (server/.env or root .env) ───────────────────────────────

# JWT secret — use a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-in-production"

# Starlink connection mode:
#   mock   — uses built-in demo data, no hardware needed (default)
#   local  — connects to dish at STARLINK_LOCAL_IP via gRPC (must be on same LAN)
#   remote — uses authenticated Starlink cloud API (session cookies, 15-day refresh)
STARLINK_MODE="mock"

# IP of the Starlink dish on your local network (only needed when STARLINK_MODE=local)
STARLINK_LOCAL_IP="192.168.100.1"

# Directory for Starlink session cookie files (STARLINK_MODE=remote)
# Each file must be named: <starlink_account_email>.json
# How to export cookies:
#   1. Log into https://www.starlink.com in Chrome or Firefox
#   2. Install the "Cookie-Editor" browser extension
#   3. Click the extension → Export → JSON
#   4. Save the file to this directory as <your-email@starlink.com>.json
# Cookies are valid for 15 days; the library auto-refreshes them.
STARLINK_COOKIE_DIR="server/cookies"

# Operator login accounts: comma-separated "email:bcrypt_hash" pairs
# Default hash below is for password "password123" — CHANGE IN PRODUCTION
# Generate a new hash: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"
OPERATOR_ACCOUNTS="admin@enjojofoundation.org:$2b$12$ohGXFZAjFyhMA2BP6i3e1u7tQmjHyZQEIGaaWXfgsrjLkkLSLeaGO"
